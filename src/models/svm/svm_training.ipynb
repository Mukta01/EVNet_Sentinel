{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# SVM Model Training and Evaluation\n",
    "\n",
    "This notebook trains a Support Vector Machine (SVM) on the preprocessed CICEVSE2024 dataset. It includes data loading, evaluation, and hyperparameter tuning using `GridSearchCV`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import joblib\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.svm import LinearSVC\n",
    "from sklearn.model_selection import GridSearchCV\n",
    "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, confusion_matrix, classification_report\n",
    "\n",
    "# Ensure plots are displayed inline\n",
    "%matplotlib inline"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Data\n",
    "Load the preprocessed train, validation, and test datasets. Note: ensure `preprocess.py` has been run previously."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Adjust path assuming the notebook runs from the project root or src/models/svm\n",
    "import sys\n",
    "if os.path.exists('../../../data/processed'):\n",
    "    DATA_DIR = '../../../data/processed'\n",
    "elif os.path.exists('data/processed'):\n",
    "    DATA_DIR = 'data/processed'\n",
    "else:\n",
    "    DATA_DIR = '../data/processed' # fallback\n",
    "\n",
    "print(f\"Using data directory: {DATA_DIR}\")\n",
    "\n",
    "X_train = pd.read_csv(os.path.join(DATA_DIR, \"X_train.csv\"))\n",
    "y_train = pd.read_csv(os.path.join(DATA_DIR, \"y_train.csv\"))\n",
    "X_val = pd.read_csv(os.path.join(DATA_DIR, \"X_val.csv\"))\n",
    "y_val = pd.read_csv(os.path.join(DATA_DIR, \"y_val.csv\"))\n",
    "X_test = pd.read_csv(os.path.join(DATA_DIR, \"X_test.csv\"))\n",
    "y_test = pd.read_csv(os.path.join(DATA_DIR, \"y_test.csv\"))\n",
    "\n",
    "y_train_binary = y_train[\"Label_Binary\"].values.ravel()\n",
    "y_train_multi = y_train[\"Label_Multiclass\"].values.ravel()\n",
    "y_val_binary = y_val[\"Label_Binary\"].values.ravel()\n",
    "y_val_multi = y_val[\"Label_Multiclass\"].values.ravel()\n",
    "y_test_binary = y_test[\"Label_Binary\"].values.ravel()\n",
    "y_test_multi = y_test[\"Label_Multiclass\"].values.ravel()\n",
    "\n",
    "print(\"Data loaded successfully!\")\n",
    "print(f\"X_train shape: {X_train.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Hyperparameter Tuning (Binary Classification)\n",
    "We use `LinearSVC` as it scales better to large datasets. We'll tune the `C` parameter (regularization strength) using cross-validation on the training set."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Starting Hyperparameter Tuning for Binary Model...\")\n",
    "param_grid = {'C': [0.01, 0.1, 1, 10]}\n",
    "\n",
    "svm_grid = GridSearchCV(LinearSVC(random_state=42, dual=False, max_iter=2000), \n",
    "                        param_grid, \n",
    "                        cv=3, \n",
    "                        scoring='f1', \n",
    "                        n_jobs=-1, \n",
    "                        verbose=2)\n",
    "\n",
    "svm_grid.fit(X_train, y_train_binary)\n",
    "\n",
    "print(f\"Best Parameters: {svm_grid.best_params_}\")\n",
    "print(f\"Best CV F1-Score: {svm_grid.best_score_:.4f}\")\n",
    "\n",
    "best_binary_model = svm_grid.best_estimator_"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Evaluation Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_model(model, X, y, title_prefix=\"\", is_multiclass=False):\n",
    "    preds = model.predict(X)\n",
    "    avg_method = 'weighted' if is_multiclass else 'binary'\n",
    "    \n",
    "    print(f\"--- {title_prefix} Classification Report ---\")\n",
    "    print(classification_report(y, preds, zero_division=0))\n",
    "    \n",
    "    cm = confusion_matrix(y, preds)\n",
    "    plt.figure(figsize=(6,4))\n",
    "    sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\")\n",
    "    plt.title(f\"{title_prefix} Confusion Matrix\")\n",
    "    plt.ylabel('Actual')\n",
    "    plt.xlabel('Predicted')\n",
    "    plt.show()\n",
    "    return preds"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Evaluate Binary Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "_ = evaluate_model(best_binary_model, X_val, y_val_binary, title_prefix=\"Binary Validation\")\n",
    "_ = evaluate_model(best_binary_model, X_test, y_test_binary, title_prefix=\"Binary Test\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Train & Evaluate Multiclass Model\n",
    "For the multiclass model, we will use the best `C` parameter found during the binary search, or you can re-run `GridSearchCV`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "best_C = svm_grid.best_params_['C']\n",
    "print(f\"Training Multiclass model with C={best_C}...\")\n",
    "\n",
    "best_multi_model = LinearSVC(C=best_C, random_state=42, dual=False, max_iter=2000)\n",
    "best_multi_model.fit(X_train, y_train_multi)\n",
    "\n",
    "_ = evaluate_model(best_multi_model, X_val, y_val_multi, title_prefix=\"Multiclass Validation\", is_multiclass=True)\n",
    "_ = evaluate_model(best_multi_model, X_test, y_test_multi, title_prefix=\"Multiclass Test\", is_multiclass=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Save Models\n",
    "Export the best models to the `saved_models` directory."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if os.path.exists('../../../saved_models'):\n",
    "    SAVE_DIR = '../../../saved_models'\n",
    "elif os.path.exists('saved_models'):\n",
    "    SAVE_DIR = 'saved_models'\n",
    "else:\n",
    "    SAVE_DIR = '../saved_models'\n",
    "\n",
    "os.makedirs(SAVE_DIR, exist_ok=True)\n",
    "joblib.dump(best_binary_model, os.path.join(SAVE_DIR, \"svm_model_binary.pkl\"))\n",
    "joblib.dump(best_multi_model, os.path.join(SAVE_DIR, \"svm_model_multiclass.pkl\"))\n",
    "\n",
    "print(\"Models saved successfully!\")"
   ]
  }
 ],
