# Ignore virtual environments
.env
.venv
env/
venv/

# Python cache files
__pycache__/
*.pyc
*.pyo

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore serialized ML models (unless you explicitly want to commit them, which is not recommended for large models)
# We will track the saved_models folder itself via a .gitkeep, but ignore its contents if needed
# Actually, for a small academic project, you might want to commit small .pkl files so your teammates have access.
# If you DO NOT want to commit models, uncomment the line below:
# saved_models/*.pkl
# Datasets and large files (Strictly ignored to prevent GitHub upload limits)
datasets/
data/raw/*
!data/raw/.gitkeep
*.csv
*.tar
*.tar.xz
*.zip
*.gz

# OS specific files
.DS_Store

# Ignore IDE specific folders
.vscode/
.idea/

# Versioned preprocessing outputs (issue #50). CSVs are already covered by the
# *.csv rule above; the fitted scaler is written alongside its own dataset so a
# re-run cannot silently invalidate models trained on an earlier version.
data/processed*/**/*.pkl
data/reproduction/

# Corrected-pipeline model artifacts (issues #46/#54). Regenerable via
# `make data-process` + the per-model training scripts; the Random Forest alone
# is 38 MB and the ARF pipelines up to 97 MB, so they are not version-controlled.
saved_models/leakfree*/
saved_models/arf_*_multiclass.pkl
saved_models/arf_*_binary.pkl

# Long-running job logs (ARF full-stream runs)
logs/*.log

# Model artifacts are no longer version-controlled (issue #55). They are large and
# environment-specific, and `src/api/main.py` loads every .pkl it finds in
# saved_models/ -- so a stale committed model gets served silently. Regenerate
# with `make data-process` plus the per-model training scripts.
saved_models/*.pkl
saved_models/_superseded/

# Next.js build caches and capture scratch (churns on every dev run)
frontend/.next/
frontend/.next-figma-capture/

# Multi-seed intermediate splits (regenerate with src/evaluation/run_experiments.py)
data/multiseed/
saved_models/arf-full/
